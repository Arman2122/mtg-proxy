#!/bin/sh
# publish-cover-site -- put a new version of the cover website live.
#
#   publish-cover-site site.tar.gz     publish the archive (or read it from stdin)
#   publish-cover-site --rollback      go back to the previous version
#   publish-cover-site --list          show the kept versions
#
# The archive holds the site's files with index.html at its top level, the way
#   tar -C <site-folder> -czf site.tar.gz .
# makes it. Each version is unpacked into its own directory under
# /var/www/cover-releases, and /var/www/cover -- the directory Caddy serves --
# is a symlink switched to it in one rename, so a visitor never sees half a
# site. The five newest versions are kept.
set -eu

releases=/var/www/cover-releases
live=/var/www/cover
keep=5

list() {
	ls -1 "$releases" | sort
}

switch_to() {
	ln -sfn "$releases/$1" "$live.switch"
	mv -T "$live.switch" "$live"
	echo "live: $1"
}

case "${1:-}" in
--list)
	current=$(basename "$(readlink -f "$live")")
	list | while read -r r; do
		if [ "$r" = "$current" ]; then echo "$r  (live)"; else echo "$r"; fi
	done
	exit 0
	;;
--rollback)
	current=$(basename "$(readlink -f "$live")")
	previous=$(list | awk -v c="$current" '$0 < c' | tail -n 1)
	[ -n "$previous" ] || { echo "no earlier version to go back to" >&2; exit 1; }
	switch_to "$previous"
	exit 0
	;;
-h | --help)
	sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
	;;
esac

archive=${1:--}
name=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "$releases"

# A site that was already there, as a plain directory, becomes the oldest
# version rather than being overwritten, so --rollback can still reach it.
if [ -d "$live" ] && [ ! -L "$live" ]; then
	mv "$live" "$releases/00000000T000000Z-original"
	ln -s "$releases/00000000T000000Z-original" "$live"
	echo "kept the existing site as version 00000000T000000Z-original"
fi
staging=$(mktemp -d "$releases/.incoming.XXXXXX")
trap 'rm -rf "$staging"' EXIT

if [ "$archive" = "-" ]; then
	tar -xzf - -C "$staging" --no-same-owner --no-same-permissions
else
	tar -xzf "$archive" -C "$staging" --no-same-owner --no-same-permissions
fi

[ -f "$staging/index.html" ] || {
	echo "refusing: no index.html at the top of the archive (make it with: tar -C <site-folder> -czf site.tar.gz .)" >&2
	exit 1
}

chmod -R u=rwX,go=rX "$staging"
mv "$staging" "$releases/$name"
trap - EXIT
switch_to "$name"
echo "files: $(find "$releases/$name" -type f | wc -l)"

list | head -n -"$keep" | while read -r old; do
	[ "$releases/$old" = "$(readlink -f "$live")" ] || rm -rf "${releases:?}/$old"
done
