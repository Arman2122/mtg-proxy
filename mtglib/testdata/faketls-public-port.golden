flight.1.handshake-length 000076
flight.1.server-version 0303
flight.1.random <masked:32> faketls-digest
flight.1.session-id-length 32
flight.1.session-id 1111111111111111111111111111111111111111111111111111111111111111
flight.1.cipher-suite 1301
flight.1.suffix 00002e002b0002030400330024001d0020
flight.1.key-share <masked:32> x25519
