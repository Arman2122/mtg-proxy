# mtg-proxy configuration.
#
# Users go in the table at the end, one per line:
# [secrets]
# alice = "a commented-out line is not a key"
bind-to = "0.0.0.0:3128"

# The fronting site, for clients that fail the handshake.
[domain-fronting]
port = 443

[[retiring-secret]]
# added by mtg-proxy rotate-secret at 2026-10-08T09:30:00Z
name   = "alice"
secret = "eea1a1a1a1b2b2b2b2c3c3c3c3d4d4d4d473746f726167652e676f6f676c65617069732e636f6d"
until  = "2026-10-09T09:30:00Z"

# ---------------------------------------------------------------------
# Users. Each key is a name, each value a secret.
# Append new users at the end of this table.
[secrets]
alice = "eec0ffee00c0ffee00c0ffee00c0ffee0073746f726167652e676f6f676c65617069732e636f6d" # the admin
bob = "3333333333333333cccccccccccccccc"
